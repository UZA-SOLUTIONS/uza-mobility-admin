NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:7000
# Optional — guest marketplace (FN) origin for “View on marketplace” links.
# When unset, those links stay inactive.
# NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000

# Required by NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated image CDN hostnames for next/image
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=cdn.example.com
